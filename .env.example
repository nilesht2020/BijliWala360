# SkillConnect local development environment. Copy to .env and adjust.
# Infrastructure and secrets ONLY: business configuration lives in the admin settings (business_settings).

NODE_ENV=development
PORT=3000
WORKER_HEALTH_PORT=3001
LOG_LEVEL=debug
LOG_PRETTY=true
CORS_ORIGINS=http://localhost:5173

# MongoDB must be a replica set (transactions). docker-compose.dev.yml starts a single-node rs0.
MONGO_URI=mongodb://localhost:27017/skillconnect?replicaSet=rs0&directConnection=true
REDIS_URL=redis://localhost:6379

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30

# Versioned AES-256 keys: "1:<base64 of 32 bytes>". Generate a key with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEYS=1:REPLACE_WITH_BASE64_32_BYTES
HASH_PEPPER=change-me-to-another-long-random-string-32+

# S3-compatible storage (MinIO locally)
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_BUCKET=skillconnect-private
S3_ACCESS_KEY_ID=skillconnect
S3_SECRET_ACCESS_KEY=skillconnect-secret
S3_FORCE_PATH_STYLE=true

CLAMAV_HOST=localhost
CLAMAV_PORT=3310

SMS_PROVIDER=console
WHATSAPP_PROVIDER=console
EMAIL_PROVIDER=console
EMAIL_FROM=SkillConnect <no-reply@skillconnect.local>

# Razorpay test-mode keys (Phase 3)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

SWAGGER_ENABLED=true

# Development without Docker: in-process jobs, files on local disk, no virus scanner.
# All three are refused when NODE_ENV=production.
QUEUE_MODE=inline
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.local-storage
SCANNER=none

# Development only: every mobile OTP is this code and the sign-in page shows it.
# Remove when a real SMS provider is integrated. Refused when NODE_ENV=production.
DEV_FIXED_OTP=123456
