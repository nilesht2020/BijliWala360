{
  "name": "@bijliwala/api",
  "version": "0.1.0",
  "private": true,
  "description": "BijliWala360 backend: NestJS modular monolith (api + worker processes)",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "start:dev": "nest start --watch",
    "start:worker:dev": "nest start --watch --entryFile worker",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "jest --runInBand --forceExit",
    "test:unit": "jest --selectProjects unit",
    "test:int": "jest --selectProjects integration --runInBand --forceExit",
    "test:cov": "jest --coverage",
    "db:sync-indexes": "node dist/cli/sync-indexes.js",
    "cli:create-admin": "node dist/cli/create-admin.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.700.0",
    "@aws-sdk/s3-request-presigner": "3.700.0",
    "@nestjs/common": "11.1.6",
    "@nestjs/core": "11.1.6",
    "@nestjs/jwt": "11.0.0",
    "@nestjs/mongoose": "11.0.3",
    "@nestjs/platform-express": "11.1.6",
    "@nestjs/swagger": "11.2.0",
    "@bijliwala/contracts": "workspace:*",
    "bullmq": "5.58.0",
    "cookie-parser": "1.4.7",
    "helmet": "8.1.0",
    "ioredis": "5.7.0",
    "mongoose": "8.18.0",
    "nestjs-pino": "4.4.0",
    "pino": "9.9.0",
    "pino-http": "10.5.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.25.76",
    "zod-to-json-schema": "3.24.6"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.10",
    "@nestjs/schematics": "11.0.7",
    "@nestjs/testing": "11.1.6",
    "@bijliwala/tsconfig": "workspace:*",
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.3",
    "@types/jest": "29.5.14",
    "@types/node": "22.18.0",
    "@types/supertest": "6.0.3",
    "ioredis-mock": "8.9.0",
    "jest": "29.7.0",
    "mongodb-memory-server": "10.2.0",
    "pino-pretty": "13.1.1",
    "supertest": "7.1.4",
    "ts-jest": "29.4.4",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.8.3"
  }
}
