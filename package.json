{
  "name": "bijliwala",
  "private": true,
  "version": "0.1.0",
  "description": "Bijli Wala B2B service marketplace (modular monolith)",
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "build:contracts": "pnpm --filter @bijliwala/contracts run build",
    "dev:api": "pnpm --filter @bijliwala/api run start:dev",
    "dev:worker": "pnpm --filter @bijliwala/api run start:worker:dev",
    "dev:web": "pnpm --filter @bijliwala/web run dev",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,css}\""
  },
  "devDependencies": {
    "@eslint/js": "9.39.0",
    "eslint": "9.39.0",
    "prettier": "3.6.2",
    "typescript": "5.8.3",
    "typescript-eslint": "8.46.0",
    "eslint-plugin-react-hooks": "5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "mongodb-memory-server",
      "@nestjs/core",
      "esbuild",
      "msgpackr-extract"
    ]
  },
  "type": "module"
}
